FROM ros:jazzy-ros-base
SHELL ["/bin/bash","-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3-colcon-common-extensions python3-pytest \
    ros-jazzy-vision-msgs ros-jazzy-sensor-msgs && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY autonomy_ws/src/autonomymind_interfaces /workspace/src/autonomymind_interfaces
COPY autonomy_ws/src/autonomymind_decision /workspace/src/autonomymind_decision
COPY autonomy_ws/src/autonomymind_perception /workspace/src/autonomymind_perception
COPY autonomy_ws/src/autonomymind_sensor_fusion /workspace/src/autonomymind_sensor_fusion
COPY autonomy_ws/src/autonomymind_tracking /workspace/src/autonomymind_tracking
RUN source /opt/ros/jazzy/setup.bash && \
    colcon build --packages-select autonomymind_interfaces autonomymind_perception autonomymind_sensor_fusion autonomymind_tracking autonomymind_decision \
      --cmake-args -DBUILD_TESTING=ON
CMD ["bash","-lc","source /opt/ros/jazzy/setup.bash && source /workspace/install/setup.bash && colcon test --packages-select autonomymind_interfaces autonomymind_perception autonomymind_sensor_fusion autonomymind_tracking autonomymind_decision --event-handlers console_direct+ && colcon test-result --verbose"]
