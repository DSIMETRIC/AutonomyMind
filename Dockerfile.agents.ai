FROM ros:jazzy-ros-base
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/agent-ai && /opt/agent-ai/bin/pip install --no-cache-dir numpy==1.26.4 onnx==1.17.0 onnxruntime==1.20.1
ENV PYTHONPATH=/workspace/src PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY src/ /workspace/src/
COPY scripts/train_reference_ranker.py /workspace/train_reference_ranker.py
COPY simulation/pilots/ /workspace/pilots/
