{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomymind.dev/schemas/isaac_scenario.schema.json",
  "title": "AutonomyMindIsaacScenario",
  "type": "object",
  "required": ["schema_version", "scenario_id", "frames"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp_s", "frame_id", "source", "ego", "obstacle"],
        "properties": {
          "timestamp_s": {"type": "number"},
          "frame_id": {"type": "string"},
          "source": {"type": "string"},
          "ego": {"type": "object"},
          "obstacle": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
