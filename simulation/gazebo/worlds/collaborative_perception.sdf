<?xml version="1.0"?>
<sdf version="1.9">
 <world name="closed_loop_reference">
  <physics name="physics" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
<light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction></light>
  <model name="ground"><static>true</static><link name="ground"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></visual></link></model>
  <model name="rover">
<pose>0 0 0 0 0 0</pose>
<link name="base_link">
<inertial><pose>0 0 0.3 0 0 0</pose><mass>8</mass><inertia><ixx>0.3</ixx><iyy>0.5</iyy><izz>0.5</izz></inertia></inertial>
<collision name="body"><pose>0 0 0.32 0 0 0</pose><geometry><box><size>0.7 0.45 0.24</size></box></geometry></collision>
<visual name="body"><pose>0 0 0.32 0 0 0</pose><geometry><box><size>0.7 0.45 0.24</size></box></geometry><material><diffuse>0.1 0.3 0.8 1</diffuse></material></visual>
<collision name="front_caster"><pose>0.27 0 0.06 0 0 0</pose><geometry><sphere><radius>0.06</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision><collision name="caster"><pose>-0.27 0 0.06 0 0 0</pose><geometry><sphere><radius>0.06</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
<sensor name="imu" type="imu"><always_on>true</always_on><update_rate>20</update_rate><topic>/mobile/imu</topic></sensor>
<sensor name="lidar" type="gpu_lidar"><pose>0.45 0 0.65 0 0 0</pose><always_on>true</always_on><update_rate>5</update_rate><topic>/mobile/scan</topic><lidar><scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-1.57</min_angle><max_angle>1.57</max_angle></horizontal></scan><range><min>0.08</min><max>12</max><resolution>0.02</resolution></range></lidar></sensor>
<sensor name="rgb" type="camera"><pose>0.45 0 0.65 0 0 0</pose><always_on>true</always_on><update_rate>5</update_rate><topic>/mobile/image</topic><camera><horizontal_fov>1.2</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera></sensor>
</link>
<link name="left_wheel"><pose>0 0.31 0.16 1.57079632679 0 0</pose><inertial><mass>0.5</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.006</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.10</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.10</length></cylinder></geometry></visual></link>
<joint name="left_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
<link name="right_wheel"><pose>0 -0.31 0.16 1.57079632679 0 0</pose><inertial><mass>0.5</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.006</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.10</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.10</length></cylinder></geometry></visual></link>
<joint name="right_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_joint</left_joint><right_joint>right_joint</right_joint><wheel_separation>0.62</wheel_separation><wheel_radius>0.16</wheel_radius><topic>/autonomymind_gazebo_only/cmd_vel</topic><odom_topic>/mobile/wheel_odometry</odom_topic><odom_publish_frequency>20</odom_publish_frequency></plugin>
<plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions><odom_frame>world_enu</odom_frame><robot_base_frame>rover/base_link</robot_base_frame><odom_topic>/model/rover/odometry</odom_topic><odom_publish_frequency>10</odom_publish_frequency></plugin>
</model>
  <model name="drone">
   <static>true</static><pose>0 -3 0.65 0 0 0</pose>
   <link name="base_link">
    <sensor name="lidar" type="gpu_lidar"><pose>0.3 0 0 0 0 0</pose><always_on>true</always_on><update_rate>5</update_rate><topic>/fleet/drone/scan</topic><lidar><scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-1.57</min_angle><max_angle>1.57</max_angle></horizontal></scan><range><min>0.08</min><max>12</max><resolution>0.02</resolution></range></lidar></sensor>
    <collision name="collision"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.5 0.5 0.15</size></box></geometry></collision>
    <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.5 0.5 0.15</size></box></geometry><material><ambient>0.1 0.8 0.4 1</ambient><diffuse>0.1 0.8 0.4 1</diffuse></material></visual>
   </link>
   <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
    <dimensions>3</dimensions><odom_frame>world_enu</odom_frame><robot_base_frame>drone/base_link</robot_base_frame>
    <odom_topic>/model/drone/odometry</odom_topic><odom_publish_frequency>10</odom_publish_frequency>
   </plugin>
  </model>
  <model name="obstacle">
   <static>true</static><pose>4 0 0 0 0 0</pose>
   <link name="base_link">
    <collision name="collision"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.5 0.5 1</size></box></geometry></collision>
    <visual name="body"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.5 0.5 1</size></box></geometry><material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.8 0.3 0.1 1</diffuse></material></visual>
   </link>
   <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
    <dimensions>3</dimensions><odom_frame>world_enu</odom_frame><robot_base_frame>obstacle/base_link</robot_base_frame>
    <odom_topic>/model/obstacle/odometry</odom_topic><odom_publish_frequency>10</odom_publish_frequency>
   </plugin>
  </model>
 <model name="remote_obstacle"><static>true</static><pose>4 -3 0 0 0 0</pose><link name="body"><collision name="collision"><pose>0 0 .5 0 0 0</pose><geometry><box><size>.5 .5 1</size></box></geometry></collision><visual name="visual"><pose>0 0 .5 0 0 0</pose><geometry><box><size>.5 .5 1</size></box></geometry></visual></link></model>
 </world>
</sdf>
